rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Security Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── 1. Admins Collection ───
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow update: if isAuthenticated() && request.auth.uid == adminId;
      allow create, delete: if false;
    }

    // ─── 2. Users / Customers ───
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow update: if isAdmin() || (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if false; // Soft deletes only (isActive: false)
    }

    // ─── 3. Products Catalog ───
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 4. Inventory Ledger ───
    match /inventory/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 5. Orders ───
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ─── 6. Invoices ───
    match /invoices/{invoiceId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow write: if isAdmin();
    }

    // ─── 7. Categories ───
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 8. Banners ───
    match /banners/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 9. Farmers ───
    match /farmers/{farmerId} {
      allow read, write: if isAdmin();
    }

    match /farmer_settlements/{settlementId} {
      allow read, write: if isAdmin();
    }

    // ─── 10. Farmer Loans & Advances ───
    match /farmer_loans/{loanId} {
      allow read, write: if isAdmin();
    }

    match /godowns/{godownId} {
      allow read, write: if isAdmin();
    }

    match /inventory_ledger/{ledgerId} {
      allow read, write: if isAdmin();
    }

    // ─── 10. Audit Logs (Read-only for admins, written by Cloud Functions) ───
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written exclusively by Cloud Functions via Admin SDK
    }

    // ─── 11. Settings (Global Config) ───
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 12. Notifications ───
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || false; // Usually created by Cloud Functions
      allow delete: if false;
    }

    // ─── 13. Campaigns ───
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
